```text
# SUMBANE SHARE - Node.js WebSocket Tunnel Server

# Render fournit automatiquement PORT.
# En local, le serveur utilisera 10000 si PORT/TUNNEL_PORT n'est pas défini.
PORT=10000

# Adresse d'écoute
TUNNEL_HOST=0.0.0.0

# Secret JWT
# IMPORTANT : ne jamais mettre le vrai secret ici.
# Le vrai JWT_SECRET sera configuré dans Render.
JWT_SECRET=your-jwt-secret-here

# API PHP SUMBANE SHARE sur InfinityFree
API_BASE_URL=https://sumbane-portifolio.wuaze.com/backend/public/api
```
